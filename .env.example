# Copy to .env and fill in. Never commit the real .env.

# ── LLM providers ────────────────────────────────────────────────────────────
# OpenRouter serves the answering model (deepseek-chat-v3-0324).
OPENROUTER_API_KEY=

# OpenAI serves Q-A generation and the RAGAS judge (gpt-4.1-mini).
OPENAI_API_KEY=

# ── PostgreSQL + pgvector ────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=legalchatbot2
PG_USER=postgres
PG_PASSWORD=

# Base table name. PGVectorStore stores rows in data_<table> internally, so
# `laws_vector_table_v2_512` maps to the physical table
# `public.data_laws_vector_table_v2_512`.
PG_VECTOR_TABLE=laws_vector_table_v2_512
VECTOR_TABLE=laws_vector_table_v2_512

# ── Large artefacts kept outside the repository ──────────────────────────────
# SQLite corpus of scraped ΦΕΚ documents (859 MB).
HARVESTER_DB=harvester_full.db
# Persisted LlamaIndex docstore. Use storage_512 for the 512-token index.
STORAGE_DIR=storage

# ── Retrieval / generation knobs (defaults shown) ────────────────────────────
EVAL_MODEL=deepseek/deepseek-chat-v3-0324
# SIMILARITY_TOP_K=50
# RERANK_CANDIDATES=50
# RERANK_MIN_CHUNKS=3
# RERANK_MAX_CHUNKS=10
# MAX_CONTEXT_CHARS=120000

# ── Louvain clustering (defaults shown) ──────────────────────────────────────
# LOUVAIN_K=10
# LOUVAIN_MIN_SIM=0.0
# LOUVAIN_RESOLUTION=1.0
# LOUVAIN_USE_LCC=true

# ── Google Sheets review step (src/qa_generation/review_sheet.py) ────────────
# Spreadsheet id from its URL, and the path to your OAuth client-secret JSON.
GSPREAD_SHEET_KEY=
GSPREAD_CREDENTIALS=client_secret.json
